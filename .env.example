# BREAK — environment template. Copy to .env and fill in real values.
# All EXPO_PUBLIC_* vars are inlined into the client bundle — never put
# service-role or other server-side secrets here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# Stripe publishable key (starts with pk_test_ or pk_live_) — safe to ship in
# the app bundle. Leave it blank and checkout simply skips the payment step
# (today's behavior). Setup guide: docs/PAYMENTS.md.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
