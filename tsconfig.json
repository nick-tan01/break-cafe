{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // supabase/functions is Deno code (edge functions) — not part of the app
  // bundle, and it breaks the React Native tsc run if included.
  "exclude": [
    "node_modules",
    "supabase/functions"
  ]
}

